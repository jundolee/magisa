# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 로그인(Supabase Auth) 세션 확인용 anon key — service role 키와 달리 브라우저에 노출돼도 안전하다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 일일 수집 크론 엔드포인트 보호용 임의의 랜덤 문자열 (예: openssl rand -hex 32)
CRON_SECRET=

# /sources(소스 관리) 접근을 로그인 계정 기준으로 허용할 이메일 목록 (쉼표로 구분, 대소문자 무관).
# 설정하면 이 목록의 이메일로 로그인(Google/이메일)한 사람만 /sources에 접근 가능.
ADMIN_EMAILS=

# ADMIN_EMAILS를 아직 설정하지 않았을 때(전환 전/로컬 개발)만 쓰이는 구 방식 — /sources 접근을
# 막는 관리자 비밀번호. 둘 다 비워두면(로컬 개발 등) 보호가 꺼진다.
ADMIN_PASSWORD=

# 소스 등록 시 규칙 기반 auto-detect가 실패했을 때만 호출하는 선택자 추론 폴백 (gpt-5-nano 사용).
# 비워두면 AI 폴백 없이 동작(자동 인식 실패 시 바로 수동 입력 화면으로 감).
OPENAI_API_KEY=

# Amplitude 프로젝트 API 키 (브라우저 SDK용). 비워두면 Amplitude 초기화를 하지 않는다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
